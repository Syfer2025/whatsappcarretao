# Copie para .env e substitua TODOS os valores CHANGE_ME antes do deploy.
# Nunca versionar .env. Prefira segredos aleatórios sem espaços, aspas ou `$`.

# Obrigatórios de produção
DOMAIN=app.example.com
APP_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
# OPCIONAL: presente = login do super admin exige código do autenticador (2FA);
# vazio = login só com e-mail e senha (decisão do operador, 15/jul/2026).
# Gere com: npm run superadmin:totp:setup -- admin@example.com
SUPERADMIN_TOTP_SECRET=

# Stripe obrigatório em produção. Escolha UMA estratégia:
#   A) deixe BASIC/PRO vazios e preencha STRIPE_PRICE_ID como fallback único; OU
#   B) deixe STRIPE_PRICE_ID vazio e preencha os dois preços por plano abaixo.
# Para os planos de 5 e 10 usuários, a estratégia B é a recomendada.
STRIPE_SECRET_KEY=CHANGE_ME_SK_LIVE
STRIPE_WEBHOOK_SECRET=CHANGE_ME_WHSEC
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_BASIC=CHANGE_ME_PRICE_BASIC
STRIPE_PRICE_ID_PRO=CHANGE_ME_PRICE_PRO
STRIPE_NETWORK_RETRIES=2
STRIPE_TIMEOUT_MS=20000
# Uma vaga fica reservada somente enquanto o primeiro Checkout estiver aberto.
# A Stripe aceita de 30 minutos a 24 horas; expirado o prazo, a conta
# abandonada e removida somente apos confirmacao remota da expiracao.
STRIPE_CHECKOUT_RESERVATION_MINUTES=30

# Cloudflare Turnstile obrigatorio no cadastro publico. Restrinja o widget ao
# DOMAIN acima; a chave secreta existe somente no backend.
TURNSTILE_SITE_KEY=CHANGE_ME_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY

# Identidade visual
APP_NAME="WhatsApp AI"
APP_COMPANY=
SUPERADMIN_NOTIFY_EMAIL=

# SMTP opcional, necessário para e-mails reais
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Docker, proxy reverso e deploy
HOST_BIND=127.0.0.1
TRUST_PROXY=1
APP_IMAGE=whatsa-ai:local
# Devem ser o UID/GID do usuário não-root que executa o deploy e possui os volumes.
APP_UID=1000
APP_GID=1000
DEPLOY_WAIT_TIMEOUT=180
# Inclui até 105 s de drenagem interna e margem para fechamento do SQLite.
DEPLOY_STOP_TIMEOUT=120
SMOKE_RETRIES=12
SMOKE_RETRY_DELAY=5
MIN_FREE_DISK_MB=4096
BACKUP_FREE_MARGIN_MB=2048
LOCAL_SMOKE_URL=http://127.0.0.1:3000/health/ready
PUBLIC_SMOKE_URL=https://app.example.com/health/ready
LOG_LEVEL=info
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
# Cinco sessões exigem, no mínimo, VPS de 4 vCPU/8 GiB para preservar recursos
# do sistema operacional, proxy e Docker. O deploy recusa host menor.
MEMORY_LIMIT=6g
CPU_LIMIT=3.0
PIDS_LIMIT=1024

# Backup local; envie snapshots para armazenamento offsite/imutável separadamente
# Snapshots são completos (bancos, mídias e autenticação). Quatro cópias locais
# limitam crescimento; retenção histórica deve ficar em storage offsite.
BACKUP_RETENTION=4
BACKUP_LOCK_STALE_MS=86400000

# WhatsApp. O Compose fixa WA_BROWSER_MODE=isolated e NODE_ENV=production.
WA_NO_SANDBOX=false
WHATSAPP_HEADLESS=true
FFMPEG_PATH=/usr/bin/ffmpeg
# Limiar operacional conservador para uma VPS de 6 GiB. Meça RAM/PIDs antes de elevar.
WA_MAX_CONCURRENT_SESSIONS=5
# O tenant legado/default não pode consumir uma vaga reservada a clientes.
WA_START_DEFAULT_SESSION=false
# Cache descartável por Chromium; credenciais e IndexedDB ficam preservados.
WA_DISK_CACHE_BYTES=67108864
WA_MEDIA_CACHE_BYTES=33554432
WA_RESTORE_STAGGER_MS=1500
WA_HEALTH_CHECK_INTERVAL_MS=30000
WA_HEALTH_CHECK_TIMEOUT_MS=10000
WA_HEALTH_CHECK_MAX_FAILURES=2
WA_STATE_STUCK_TIMEOUT_MS=120000
WA_RECONNECT_BASE_MS=5000
WA_RECONNECT_MAX_MS=60000
# Nome legado: número de degraus exponenciais; a reconexão transitória é contínua.
WA_RECONNECT_MAX_ATTEMPTS=5
WA_PROXY_SERVER=
WHATSAPP_USER_AGENT=
# Pin de versão do WhatsApp Web (ex.: 2.3000.1043126001). Vazio = seguir a
# versão corrente. Usar quando uma versão nova quebra o whatsapp-web.js
# (sintoma: erros minificados em getChats). O HTML da versão precisa existir
# em .wwebjs_cache/ — o cache local guarda cada versão já servida.
WA_WEB_VERSION=

# Filas, importação e sincronização
MIN_SEND_INTERVAL_MS=3000
MAX_MESSAGES_PER_HOUR=250
MAX_MESSAGE_QUEUE_SIZE=500
# A fila guarda base64 no heap: limite por tenant e limite somado entre tenants.
MAX_MESSAGE_QUEUE_BYTES=67108864
MAX_GLOBAL_MESSAGE_QUEUE_BYTES=268435456
MAX_OUTBOUND_MEDIA_BYTES=26214400
# Protege heap/disco e impede que um tenant consuma o armazenamento dos demais.
MAX_INBOUND_MEDIA_BYTES=134217728
# Base64 do WhatsApp amplia o uso de heap; estes limites são globais entre
# todos os tenants e compartilhados por tempo real/importação de histórico.
INBOUND_MEDIA_GLOBAL_CONCURRENCY=2
INBOUND_MEDIA_TENANT_CONCURRENCY=1
INBOUND_MEDIA_MAX_PENDING=100
INBOUND_MEDIA_SLOT_TIMEOUT_MS=120000
TENANT_MEDIA_QUOTA_BYTES=10737418240
MEDIA_GLOBAL_QUOTA_BYTES=53687091200
MIN_RUNTIME_FREE_DISK_MB=1024
FORWARD_MEDIA_TENANT_CONCURRENCY=2
FORWARD_MEDIA_GLOBAL_CONCURRENCY=4
OUTBOUND_SEND_TIMEOUT_MS=30000
# O histórico começa com lotes pequenos e amplia a busca apenas quando encontra lacunas.
HISTORY_IMPORT_LIMIT=50
GET_CHATS_TIMEOUT_MS=15000
HISTORY_CHAT_FETCH_TIMEOUT_MS=60000
HISTORY_IMPORT_LOCK_WAIT_MS=30000
RECENT_SYNC_INTERVAL_MS=10000
RECENT_SYNC_CHAT_LIMIT=35
RECENT_SYNC_MESSAGE_LIMIT=50
RECENT_SYNC_MAX_FETCH_LIMIT=500
FULL_SYNC_MAX_FETCH_LIMIT=2000
FULL_SYNC_ABSOLUTE_MAX_FETCH_LIMIT=20000
FULL_RECONCILE_INTERVAL_MS=900000
CONVERSATION_SYNC_MESSAGE_LIMIT=150
CONVERSATION_SYNC_TIMEOUT_MS=15000
CONVERSATION_SYNC_SETTLE_MS=2500
CONVERSATION_SYNC_COOLDOWN_MS=5000
OLDER_SYNC_MAX_FETCH_LIMIT=20000
OLDER_SYNC_TIMEOUT_MS=60000
INCOMING_ENRICHMENT_CONCURRENCY=2
INCOMING_ENRICHMENT_MAX_PENDING=500
# Figurinhas/mídias podem chegar antes de o WhatsApp Web liberar a chave de download.
REALTIME_MEDIA_DOWNLOAD_ATTEMPTS=4
REALTIME_MEDIA_RETRY_BASE_DELAY_MS=750
REALTIME_MEDIA_REPAIR_MAX_ATTEMPTS=5
REALTIME_MEDIA_REPAIR_LOOKBACK_HOURS=24
REALTIME_MEDIA_REPAIR_BATCH_LIMIT=100
CONTACT_SYNC_INTERVAL_MS=21600000
# Evita que cliques repetidos enfileirem chamadas pesadas no mesmo Chromium.
CONTACT_SYNC_MANUAL_COOLDOWN_MS=30000

# Rate limits
API_RATE_LIMIT_MAX=240
LOGIN_RATE_LIMIT_MAX=20
SOCKET_RATE_LIMIT_MAX=60
REGISTER_RATE_LIMIT_MAX=5

# SQLite e desligamento gracioso
SQLITE_SYNCHRONOUS=FULL
# Barreira single-writer: produção recusa uma segunda réplica no mesmo volume.
# TTL mínimo: 60000 ms; heartbeat deve ser menor que metade do TTL.
SINGLE_WRITER_LEASE_TTL_MS=90000
SINGLE_WRITER_LEASE_HEARTBEAT_MS=20000
TENANT_DB_IDLE_MS=600000
TENANT_DB_SWEEP_MS=60000
SHUTDOWN_DRAIN_TIMEOUT_MS=15000
SHUTDOWN_HTTP_TIMEOUT_MS=15000
SHUTDOWN_WHATSAPP_TIMEOUT_MS=25000

# Antivírus opcional. O binário precisa existir dentro do container.
CLAMSCAN_PATH=
CLAMSCAN_TIMEOUT_MS=15000

# Valores abaixo são invariantes de produção e não devem ser alterados:
# NODE_ENV=production
# BILLING_REQUIRED=true
# TRIAL_DAYS=3
# WA_BROWSER_MODE=isolated
# COOKIE_SECURE=true
