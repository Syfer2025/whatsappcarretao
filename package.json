{
  "name": "whatscarretao",
  "version": "1.0.0",
  "description": "Atendimento interno via WhatsApp da Auto Peças Carretão",
  "private": true,
  "main": "server.js",
  "scripts": {
    "test": "node scripts/run-tests.js",
    "lint": "eslint . --ignore-pattern 'backups/**'",
    "check": "npm run lint && npm test",
    "backup": "node scripts/backup.js",
    "backup:verify": "node scripts/verify-backup.js",
    "restore:prepare": "node scripts/prepare-restore.js",
    "integrity:audit": "node scripts/audit-integrity.js",
    "production:validate": "node scripts/validate-production-env.js",
    "superadmin:totp:setup": "node scripts/generate-superadmin-totp.js",
    "format": "prettier --write .",
    "start": "node server.js",
    "dev": "nodemon --config nodemon.json server.js"
  },
  "keywords": [
    "whatsapp",
    "atendimento",
    "interno",
    "carretao"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4"
  }
}
